# 依赖
__pycache__/
*.py[cod]
.venv/
venv/
env/

# 打包产物
# 打包到旁边目录时用的（主目录里的 exe 可能正被占用）
dist*/
# PyInstaller 的工作目录（build/<name>/），里面全是中间产物，别提交
build/mythclass/
dist/
*.egg-info/

# 配置：只提交 config.example.json
config.json

# 运行时数据（正常情况下都在 %APPDATA%\Mythclass，这儿兜个底）
*.db
client.log

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# PyInstaller 工作目录（中间产物，别提交；build/*.spec 要留着）
build/mythclass/
build/mythclass-onedir/
*.toc
warn-*.txt
xref-*.html

# 安装包产物与中间目录
installer/out/
installer/stage/
